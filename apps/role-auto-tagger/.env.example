# Copy to .env and fill in. .env is gitignored — never commit it.
# These are used only by the setup scripts in tools/. The app itself reads its token from the
# config screen, never from this file.

# Contentful organization that owns the app definition.
# Find it at https://app.contentful.com → Organization settings → the URL contains the ID.
CONTENTFUL_ORG_ID=

# Contentful Management API personal access token, with app-management rights in that
# organization. Create at https://app.contentful.com/account/profile/cma-tokens
# Set an expiry and rotate it. This token can read and write everything you can — treat it
# like a password.
CONTENTFUL_ACCESS_TOKEN=

# App definition ID. Leave empty on a fresh install: `npm run create-app-definition` prints
# the ID it creates, and you paste it back in here.
CONTENTFUL_APP_DEF_ID=
