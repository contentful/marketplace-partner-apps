# Copy to .env and fill in. .env is gitignored; this file is the template.
# All values are read only from this file (or real environment variables);
# there is no fallback to any other credential source.

# Used by `npm run upload-ci` and `npm run upsert-actions` (deploying the app).
# CONTENTFUL_ACCESS_TOKEN is a Contentful Management API personal access token.
CONTENTFUL_ORG_ID=your-organization-id
CONTENTFUL_APP_DEF_ID=your-app-definition-id
CONTENTFUL_ACCESS_TOKEN=your-cma-personal-access-token

# Used only by the local harnesses (`npm run test:proxy`, `npm run bench:alchemer`).
# The deployed app never reads these; it uses the installation parameters saved
# on the app configuration screen. Keys live in Alchemer under Account >
# Integrations > API Key (admins: Security > API Access).
ALCHEMER_API_TOKEN=your-alchemer-api-token
ALCHEMER_API_TOKEN_SECRET=your-alchemer-api-token-secret
# Optional. One of api.alchemer.com (default), api.alchemer.eu,
# api.alchemer-ca.com, api.au.alchemer.com.
# ALCHEMER_API_HOST=api.alchemer.com
